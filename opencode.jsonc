{
	"$schema": "https://opencode.ai/config.json",

	"provider": {
		"alpes-local": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Alpes Local Router",

			"options": {
				"baseURL": "http://127.0.0.1:8787/v1",
				"apiKey": "{env:ALPES_PROXY_KEY}"
			},

			"models": {
				"alpes-auto": {
					"name": "Alpes Auto — Pool completo",
					"limit": {
						"context": 131072,
						"output": 8192
					}
				},
				"alpes-agent": {
					"name": "Alpes Agent — Modelos 1M+",
					"limit": {
						"context": 1000000,
						"output": 8192
					}
				},
				"alpes-small": {
					"name": "Alpes Small — Modelos rápidos",
					"limit": {
						"context": 131072,
						"output": 4096
					}
				}
			}
		}
	},

	"compaction": {
		"auto": true,
		"prune": true,
		"reserved": 20000
	},

	"watcher": {
		"ignore": [
			"node_modules/**",
			".git/**",
			"dist/**",
			".wrangler/**",
			".local/**",
			"coverage/**"
		]
	}
}
